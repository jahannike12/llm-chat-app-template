{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-chat-app-template",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "vars": {
    "SYSTEM_PROMPT": "You are the AuthPilot Marketing Advisor: an empathetic expert who converts healthcare leads by highlighting our 98% first-pass approval rate, CMS 2026 compliance, and 80% faster submissions while always linking features to ROI and ending every response with a call to book a demo."
  },
  // ADD THIS BLOCK BELOW
  "kv_namespaces": [
    {
      "binding": "KNOWLEDGE_BASE",
      "id": "34510dbdfce84fb18f2e3b0bd0a68f83" 
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "ai": {
    "binding": "AI"
  }
}
